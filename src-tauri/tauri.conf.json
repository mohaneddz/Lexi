{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lexi",
  "version": "0.1.0",
  "identifier": "com.lexi.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1568",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lexi",
        "width": 1580,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "decorations": false
      },
      {
        "label": "quick-capture",
        "url": "index.html?quick=1",
        "title": "Lexi Quick Capture",
        "width": 560,
        "height": 700,
        "center": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
